# Build artifacts
theme-manager/target/

# Runtime config (user-specific theme preference)
theme-manager/config.toml

# Auto-generated by theme-manager / kitty
kitty/dark-theme.auto.conf
kitty/light-theme.auto.conf
kitty/current-theme.conf

# Secrets
delphi/secrets.toml
github-copilot/
gh/
**/secrets*
**/*.secret
**/.env

# OS junk
.DS_Store
*.DS_Store

# Claude Code session data
.claude/

# Tmux plugins (managed by TPM, installed via `prefix + I`)
tmux/plugins/

# Tool caches
yarn/
raycast/
binwalk/

# Linux install artifacts (written by the platform/linux.sh install)
systemd/

# Defunct: neofetch was archived upstream and replaced by fastfetch.
# Guard against ~/.config/neofetch/ being regenerated by a stale shell
# that still has `neofetch` in its rc, by an old binary still on PATH,
# or by another tool that probes for it.
neofetch/

# GNOME / desktop runtime state. These are written by gnome-shell,
# gsettings, GTK, ibus, PulseAudio, etc. into ~/.config on every login;
# they're machine-local and not part of the dotfiles surface.
.gsd-keyboard.settings-ported
gnome-initial-setup-done
mimeapps.list
user-dirs.dirs
user-dirs.locale
dconf/
evolution/
gtk-3.0/
gtk-4.0/
ibus/
pulse/
update-notifier/
goa-1.0/
gnome-session/
nautilus/

# snyk-ls runtime cache (written by the LSP; not part of config)
snyk/

# Browser / app runtime state — like the GNOME block above, these are
# machine-local caches that get written by the app itself.
google-chrome/
chromium/
jxbrowser/
menus/
sapling/

# ─────────────────────────────────────────────────────────────────
# Site plugins — company/employer-specific code that must never be
# published. Everything under site/ is private by default; only the
# API documentation and the reference example are tracked.
# ─────────────────────────────────────────────────────────────────
site/*
!site/README.md
!site/example/

# Host-specific sync scripts (may contain internal hostnames)
sync-to-*.sh

# Private grep patterns for `make check-public`
.denylist

# Never track backups or local scratch — these have sidestepped the
# more specific rules above before.
*.bak
*.bak-*
*.orig
*.local
secrets/

# NOTE: tmux/{dark,light}-theme.auto.conf are deliberately NOT ignored,
# unlike kitty's equivalents above. Remote hosts (devservers, containers)
# have no theme-manager binary to regenerate them — tmux/theme-apply.sh
# sources them directly — so a fresh clone there must already contain them.
# They only change when the theme family/variant changes, not on every
# dark/light toggle, so the tree does not churn.

# iTerm2 app-support symlink: an absolute path into ~/Library pointing at
# runtime state (sockets, SavedState, the server binary). Machine-specific
# and not configuration.
iterm2/

# Machine-local marker written by a site plugin to silence a host-specific
# shell-rc validator. Not configuration.
skip-rc-validation
