**/secrets*
**/*.secret
**/.env

# OS junk
.DS_Store
*.DS_Store

# Claude Code session data
.claude/

# Tmux plugins (managed by TPM, installed via `prefix + I`)
tmux/plugins/

# Tool caches
yarn/
raycast/
binwalk/
