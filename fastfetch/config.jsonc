// fastfetch — replacement for the archived neofetch.
// Logo: pre-rendered colored ASCII via chafa (see fastfetch/logo.txt).
//
// To regenerate the logo from a different image (the .png/.jpg/.webp files
// in this directory or any image of your choice):
//
//   chafa --format=symbols --size=28x14 ~/.config/fastfetch/duck.png \
//     > ~/.config/fastfetch/logo.txt
//
// The data-raw logo type means fastfetch prints the file verbatim, so it
// works on any truecolor terminal (kitty, iTerm, Ghostty, GNOME Terminal,
// Alacritty, ...) without needing libchafa linked into fastfetch itself.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "title": "blue",
      "keys": "blue"
    },
    "key": {
      "width": 11
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "blue",
        "host": "cyan"
      }
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    {
      "type": "display",
      "key": "Resolution"
    },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    {
      "type": "terminalfont",
      "key": "Font"
    },
    "break",
    "colors"
  ]
}
