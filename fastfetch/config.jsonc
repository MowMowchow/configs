// fastfetch — replacement for the archived neofetch.
// Mirrors the prior layout: custom ASCII logo on the left, then
// title / separator / OS / Host / Kernel / Uptime / Shell / Display /
// Terminal / CPU / GPU / Memory / Font / colors.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/girl.asc",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "title": "blue",
      "keys": "blue"
    },
    "key": {
      "width": 11
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "blue",
        "host": "cyan"
      }
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    {
      "type": "display",
      "key": "Resolution"
    },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    {
      "type": "terminalfont",
      "key": "Font"
    },
    "break",
    "colors"
  ]
}
